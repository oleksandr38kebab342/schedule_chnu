# Скопіювати у backend/.env і змінити значення під своє середовище.

# Для запуску через docker compose host = db / cache, локально = localhost
DATABASE_URL=postgresql+psycopg://rozklad:rozklad@localhost:5432/rozklad
REDIS_URL=redis://localhost:6379/0

# Обовʼязково замінити у production (openssl rand -hex 32)
JWT_SECRET=dev-only-secret-replace-me-before-deploy
ACCESS_TOKEN_TTL_MINUTES=480

# Початковий суперадміністратор для scripts/seed.py
# Домени на кшталт .local валідатор email відкидає як зарезервовані.
SEED_ADMIN_EMAIL=admin@chnu.edu.ua
SEED_ADMIN_PASSWORD=admin12345
